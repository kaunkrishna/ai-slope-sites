---
interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;

const icons: Record<string, string> = {
  link: 'M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71',
  text: 'M4 6h16M4 12h16M4 18h7',
  wifi: 'M12 20h.01M8.5 16.5a5 5 0 017 0M5 12.55a11 11 0 0114.08 0M1.42 9a16 16 0 0121.16 0',
  mail: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6',
  user: 'M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2 M12 11a4 4 0 100-8 4 4 0 000 8z',
  phone: 'M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z',
  message: 'M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z',
  location: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z M12 7a3 3 0 100 6 3 3 0 000-6z',
};

const iconPath = icons[icon] || icons.link;
---

<button
  class="bg-surface-1 border border-hairline rounded-xl p-5 text-left hover:border-white/15 transition-all group cursor-default"
>
  <div class="w-10 h-10 rounded-full bg-surface-2 flex items-center justify-center mb-3 group-hover:bg-white/5 transition-colors">
    <svg class="w-5 h-5 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPath} />
    </svg>
  </div>
  <h3 class="text-framer-body font-semibold text-ink mb-1">{title}</h3>
  <p class="text-framer-body-sm text-ink-muted">{description}</p>
</button>
