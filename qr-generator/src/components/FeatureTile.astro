---
interface Props {
  gradient: 'violet' | 'magenta' | 'orange' | 'coral';
  title: string;
  description: string;
  icon: string;
}

const { gradient, title, description, icon } = Astro.props;

const gradientClass = `gradient-spotlight-${gradient}`;

const icons: Record<string, string> = {
  zap: 'M13 10V3L4 14h7v7l9-11h-7z',
  sparkles: 'M12 2l2.09 6.26L20 9.27l-4.73 3.94L16.18 20 12 16.77 7.82 20l.9-6.79L4 9.27l5.91-1.01L12 2z',
  palette: 'M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10a2.5 2.5 0 002.5-2.5c0-.61-.23-1.2-.64-1.67a.528.528 0 01-.13-.33c0-.29.24-.5.53-.5H16c3.31 0 6-2.69 6-6 0-4.96-4.49-8-10-8zM5.5 13c-.83 0-1.5-.67-1.5-1.5S4.67 10 5.5 10s1.5.67 1.5 1.5S6.33 13 5.5 13zm3-4C7.67 9 7 8.33 7 7.5S7.67 6 8.5 6s1.5.67 1.5 1.5S9.33 9 8.5 9zm7 0c-.83 0-1.5-.67-1.5-1.5S14.67 6 15.5 6s1.5.67 1.5 1.5S16.33 9 15.5 9zm3 4c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z',
  download: 'M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z',
};

const iconPath = icons[icon] || icons.zap;
---

<div class={`${gradientClass} rounded-3xl p-8 md:p-10`}>
  <div class="w-12 h-12 rounded-full flex items-center justify-center mb-6 bg-white/15">
    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPath} />
    </svg>
  </div>
  <h3 class="font-display text-[28px] md:text-[32px] font-semibold leading-[1.13] tracking-[-1.0px] text-white mb-3">
    {title}
  </h3>
  <p class="text-framer-body text-white/80 leading-relaxed max-w-[480px]">
    {description}
  </p>
</div>
