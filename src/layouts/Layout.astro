---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
}

const {
	title = 'Font Finder: Find Fonts From Images & Free Alternatives',
	description = 'Use Font Finder to upload an image, identify likely font matches, and compare free, licensable alternatives.',
	canonical = 'https://fontfinder.com/',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Font Finder" />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content="https://fontfinder.com/og-image.svg" />
		<meta property="og:image:secure_url" content="https://fontfinder.com/og-image.svg" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Font Finder — find fonts from images and free alternatives" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://fontfinder.com/og-image.svg" />
		<meta name="twitter:image:alt" content="Font Finder — find fonts from images and free alternatives" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Font Finder" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-canvas text-ink antialiased">
		<slot />
	</body>
</html>
